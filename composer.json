{
    "name": "ghanem/basata",
    "type": "library",
    "description": "A Laravel package that provides an interface to the Basata payment services API.",
    "keywords": [
        "Laravel",
        "PHP",
        "Basata",
        "API",
        "Payment"
    ],
    "homepage": "https://github.com/gaitco/basata",
    "license": "MIT",
    "authors": [
        {
            "name": "Abdullah Ghanem",
            "email": "3bdullah.ghanem@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.5",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ghanem\\Basata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ghanem\\Basata\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ghanem\\Basata\\BasataServiceProvider"
            ],
            "aliases": {
                "Basata": "Ghanem\\Basata\\Facades\\Basata"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-f": "vendor/bin/phpunit --filter"
    }
}
